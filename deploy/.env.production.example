# Copy to .env.production on the VM and edit secrets.
# Domain: https://lumc-dodoma.duckdns.org

DJANGO_SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lumc-dodoma.duckdns.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://lumc-dodoma.duckdns.org,http://lumc-dodoma.duckdns.org

DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=tanzania_gis_db
DB_NAME_DETAILED=DETAILED PLANNNING 

GIS_PORTAL_URL=https://lumc-dodoma.duckdns.org
DONATION_SITE_URL=https://lumc-dodoma.duckdns.org

# DuckDNS (for renew / update scripts)
DUCKDNS_TOKEN=PUT_YOUR_DUCKDNS_TOKEN_HERE
DUCKDNS_DOMAIN=lumc-dodoma
